{
  "name": "@epam/ai-dial-typescript-sdk",
  "version": "0.1.0",
  "description": "Type-safe SDK (openapi-typescript + openapi-fetch)",
  "license": "Apache-2.0",
  "homepage": "https://epam.github.io/ai-dial-typescript-sdk/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epam/ai-dial-typescript-sdk.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle": "redocly bundle ./open_api_core.yaml -o ./openapi.bundle.yaml",
    "gen": "npm run bundle && openapi-typescript ./openapi.bundle.yaml -o ./src/schema.ts && node ./scripts/generate-sdk-client.mjs && tsc --noEmit && npm run format && npm run docs:generate",
    "build": "tsup src/index.ts --dts --format esm,cjs --target es2020 --sourcemap --clean",
    "dev": "tsup src/index.ts --watch --dts --format esm,cjs",
    "lint": "eslint .",
    "test": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:npm": "npm publish --access public",
    "publish:dry": "npm publish --access public --dry-run",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check",
    "docs:test": "node --test tests/docs/*.test.mjs",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.35.1",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2"
  }
}
