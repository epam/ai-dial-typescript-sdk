        {
          "const": 1,
          "title": "Coding",
          "dial:widgetOptions": {
            "confirmationMessage": null,
            "populateText": "I want to learn how to code",
            "submit": true
          }
        },
        {
          "const": 2,
          "title": "Writing",
          "dial:widgetOptions": {
            "confirmationMessage": null,
            "populateText": "I want to write an essay",
            "submit": true
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
